#include "libft.h"

void	*ft_memset(void *s, int c, size_t n)
{
	unsigned char	*temp_ptr;

	temp_ptr = (unsigned char *) s;
	while (n > 0)
	{
		*temp_ptr = (unsigned char) c;
		temp_ptr++;
		n--;
	}
	return (s);
}
