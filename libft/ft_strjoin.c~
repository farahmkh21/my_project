#include "libft.h"

char	*ft_strjoin(char const *s1, char const *s2)
{
	size_t	s1len;
	size_t	s2len;
	char	*str;
	size_t	i;

	if (!s1 || !s2)
		return (NULL);
	s1len = ft_strlen(s1);
	s2len = ft_strlen(s2);
	str = (char *) malloc (s1len + s2len + 1);
	if (!str)
		return (NULL);
	i = 0;
	while (i < s1len)
	{
		str [i] = s1[i];
		i++;
	}
	while (i - s1len < s2len)
	{
		str[i] = s2 [i - s1len];
		i++;
	}
	str [i] = '\0';
	return (str);
}
