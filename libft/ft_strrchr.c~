#include "libft.h"

char	*ft_strrchr(const char *s, int c)
{
	size_t	i;
	char	*last;

	i = 0;
	last = NULL;
	while (s[i])
	{
		if (s[i] == (char) c)
		{
			last = (char *) &s[i];
		}
		i++;
	}
	if (s[i] == (char) c)
		last = (char *) &s[i];
	return (last);
}
