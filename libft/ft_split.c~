#include "libft.h"

static int	ft_count_words(const char *s, char c)
{
	int	i;
	int	count;

	i = 0;
	count = 0;
	while (s[i])
	{
		while (s[i] && s[i] == c)
			i++;
		if (s[i])
			count++;
		while (s[i] && s[i] != c)
			i++;
	}
	return (count);
}

static void	ft_free_split(char **split, int i)
{
	while (i > 0)
	{
		i--;
		free (split[i]);
	}
	free (split);
}

static char	*ft_get_word(const char *s, char c)
{
	char	*word;
	int		i;
	int		len;

	i = 0;
	len = 0;
	while (s[len] && s[len] != c)
		len++;
	word = (char *) malloc(sizeof (char) * (len + 1));
	if (!word)
		return (NULL);
	while (i < len)
	{
		word [i] = s[i];
		i++;
	}
	word[i] = '\0';
	return (word);
}

static char	**ft_fill_word(const char *s, char c, char **split)
{
	int	i;

	i = 0;
	while (*s)
	{
		while (*s && *s == c)
			s++;
		if (*s)
		{
			split[i] = ft_get_word(s, c);
			if (!split[i])
			{
				ft_free_split(split, i);
				return (NULL);
			}
			i++;
		}
		while (*s && *s != c)
			s++;
	}
	split[i] = NULL;
	return (split);
}

char	**ft_split(char const *s, char c)
{
	char	**split;
	int		words;

	if (!s)
		return (NULL);
	words = ft_count_words(s, c);
	split = (char **) malloc(sizeof(char *) * (words + 1));
	if (!split)
		return (NULL);
	return (ft_fill_word(s, c, split));
}
