#include "libft.h"

void	*ft_memchr(const void *s, int c, size_t n)
{
	const unsigned char	*temp_ptr;

	temp_ptr = (const unsigned char *)s;
	while (n > 0)
	{
		if (*temp_ptr == (unsigned char)c)
			return ((void *) temp_ptr);
		temp_ptr++;
		n--;
	}
	return (NULL);
}
