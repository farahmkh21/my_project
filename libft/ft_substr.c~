#include "libft.h"

char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	size_t	slen;
	char	*sub;

	if (!s)
		return (NULL);
	slen = ft_strlen(s);
	if (start >= slen)
	{
		sub = malloc (1);
		if (!sub)
			return (NULL);
		sub [0] = '\0';
		return (sub);
	}
	if (len > slen - start)
		len = slen - start;
	sub = (char *) malloc (len + 1);
	if (!sub)
		return (NULL);
	ft_memcpy(sub, s + start, len);
	sub [len] = '\0';
	return (sub);
}
